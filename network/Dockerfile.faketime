# Besu image with libfaketime, so that one validator can run with a shifted clock.
#   docker build -f Dockerfile.faketime -t besu-faketime:26.8.1 .
ARG BESU_IMAGE=hyperledger/besu:26.8.1
FROM ${BESU_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends faketime \
    && rm -rf /var/lib/apt/lists/*
USER besu
ENTRYPOINT ["/bin/sh", "-c", "exec faketime -f \"${SKEW:-+0s}\" /opt/besu/bin/besu \"$@\"", "--"]
