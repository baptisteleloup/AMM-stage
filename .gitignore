# Foundry build outputs
out/
cache/
broadcast/
foundry.lock

# Noir circuits: compiled artefacts, witnesses and proofs
# (the generated src/*Verifier.sol files are committed, the contracts import them)
**/target/
*.gz
**/proofs/
witness.tr

# Node / TypeScript
node_modules/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.python-version
*.egg-info/

# Local deployment files and secrets
deployed_besu.json
deployed.json
netputs_nice.json
.env*

# OS and editor files
.DS_Store
*.swp
.vscode/
.idea/

# Demo runtime state and raw downloads
contracts/demo/state/
contracts/demo/data/raw/

# Experiment results are committed (overrides the out/ rule above)
!contracts/demo/econ/out/
!contracts/demo/econ/extensions/out/

# Besu network: chain data and raw block logs (too large for GitHub)
network/nodes/*/data/*
!network/nodes/*/data/key
network/besu_results/watch.jsonl
network/besu_results/skew_watch.jsonl

# Local archives and working notes
contracts/demo.zip
contracts/js_scripts/client.zip
__MACOSX/
CLEANUP.md