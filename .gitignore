 # ---- Foundry ----
out/
cache/
broadcast/
foundry.lock

# ---- Noir / circuits ----
# artefacts de compilation (nargo compile) : le JSON, la VK, le witness
**/target/
# witnesses & proofs générés localement
*.gz
**/proofs/
witness.tr
# NB : on garde Nargo.toml (source) et src/*Verifier.sol (générés MAIS
#      importés par les contrats, donc requis au build)

# ---- Node / TypeScript (js_scripts) ----
node_modules/
*.tsbuildinfo
# NB : package.json, package-lock.json et tsconfig.json sont VERSIONNÉS

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.python-version
*.egg-info/

# ---- generated files / local ----
deployed_besu.json
deployed.json
netputs_nice.json

# ---- OS / éditeur ----
.DS_Store
*.swp
.vscode/
.idea/

# --- Deployment ---
.env*

# demo runtime state and bulky caches
contracts/demo/state/
contracts/demo/data/raw/
contracts/__pycache__/
# econ results are committed (overrides the Foundry out/ rule above)
!contracts/demo/econ/out/
!contracts/demo/econ/extensions/out/

# Besu network: chain data and raw block watches (too big for GitHub)
network/nodes/*/data/*
!network/nodes/*/data/key
network/besu_results/watch.jsonl
network/besu_results/skew_watch.jsonl

# archives and local copies
contracts/demo.zip
contracts/js_scripts/client.zip
__MACOSX/
CLEANUP.md
